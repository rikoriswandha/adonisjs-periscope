---
import { withBasePath } from "@/lib/site-url";

const route = withBasePath;
---
<section class="hero-shell">
  <div class="hero-copy">
    <p class="product-context">AdonisJS 7 runtime recorder</p>
    <h1>See what your application is really doing.</h1>
    <p class="hero-summary">
      Periscope connects requests, queries, exceptions, jobs, mail, and application signals in one
      local timeline—without sending telemetry anywhere else.
    </p>
    <div class="hero-actions">
      <a class="primary-action" href={route("/get-started")}>Install Periscope</a>
      <a class="secondary-action" href={route("/reference/architecture")}>Explore the architecture</a>
    </div>
    <div class="install-command" aria-label="Installation command">
      <span aria-hidden="true">$</span>
      <code>npm install @rikology/adonisjs-periscope</code>
    </div>
  </div>

  <figure class="signal-map" aria-label="Periscope correlates application signals">
    <div class="signal-grid" aria-hidden="true"></div>
    <span class="signal-label signal-request">request</span>
    <span class="signal-label signal-query">query</span>
    <span class="signal-label signal-exception">exception</span>
    <span class="signal-label signal-job">job</span>
    <svg aria-hidden="true" class="signal-lines" viewBox="0 0 520 420" fill="none">
      <path d="M90 80C170 80 175 190 245 190"></path>
      <path d="M430 96C355 96 350 190 275 190"></path>
      <path d="M88 338C170 338 170 230 245 230"></path>
      <path d="M430 320C355 320 350 230 275 230"></path>
    </svg>
    <div class="lens">
      <svg aria-hidden="true" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="12.25" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="16" cy="3.75" r="1.65" class="fill-primary"></circle>
        <circle cx="16" cy="16" r="8.1" class="stroke-primary" stroke-width="1.5"></circle>
        <path
          d="M16 7.2V24.8M7.2 16H24.8"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>one batch</span>
    </div>
    <figcaption>Correlated locally. Ordered by capture sequence.</figcaption>
  </figure>
</section>

<section class="docs-directory" aria-labelledby="directory-heading">
  <div class="directory-intro">
    <h2 id="directory-heading">Start with the path you need.</h2>
    <p>Install in minutes, then go as deep as the investigation requires.</p>
  </div>
  <nav class="directory-links" aria-label="Documentation sections">
    <a href={route("/get-started")}>
      <span>Get started</span>
      <small>Installation, configuration, and storage</small>
    </a>
    <a href={route("/guides/dashboard")}>
      <span>Use the dashboard</span>
      <small>Search, live updates, and security</small>
    </a>
    <a href={route("/guides/watchers")}>
      <span>Record application work</span>
      <small>Watchers, hooks, commands, and troubleshooting</small>
    </a>
    <a href={route("/reference/http-api")}>
      <span>Build an integration</span>
      <small>HTTP API, adapters, and batch exports</small>
    </a>
  </nav>
</section>

<section class="batch-story" aria-labelledby="batch-heading">
  <div class="batch-copy">
    <p class="section-label">One request, one trail</p>
    <h2 id="batch-heading">See the full request, not isolated events.</h2>
    <p>
      Periscope groups related application work into a batch and keeps every entry in capture order.
      Start with a slow request or exception, then follow the queries, logs, mail, jobs, and events
      that explain it.
    </p>
    <a class="text-link" href={route("/guides/dashboard")}>
      Learn how to investigate a batch <span aria-hidden="true">→</span>
    </a>
  </div>

  <figure class="batch-timeline">
    <figcaption>
      <span>POST /orders</span>
      <small>batch_7fd2</small>
    </figcaption>
    <ol>
      <li>
        <time>00.0 ms</time>
        <span class="entry-type">request</span>
        <strong>POST /orders</strong>
        <small>started</small>
      </li>
      <li>
        <time>08.6 ms</time>
        <span class="entry-type">query</span>
        <strong>select * from products</strong>
        <small>3 rows</small>
      </li>
      <li>
        <time>23.1 ms</time>
        <span class="entry-type">event</span>
        <strong>order:created</strong>
        <small>dispatched</small>
      </li>
      <li>
        <time>29.4 ms</time>
        <span class="entry-type">job</span>
        <strong>SendOrderReceipt</strong>
        <small>scheduled</small>
      </li>
      <li>
        <time>41.8 ms</time>
        <span class="entry-type">request</span>
        <strong>201 Created</strong>
        <small>completed</small>
      </li>
    </ol>
  </figure>
</section>

<section class="capability-index" aria-labelledby="capability-heading">
  <header class="capability-heading">
    <h2 id="capability-heading">Useful from first request to deep integration.</h2>
    <p>
      The defaults are intentionally local and conservative. When you need more, every major
      boundary is documented and configurable.
    </p>
  </header>

  <div class="capability-rows">
    <article>
      <h3>Capture the work that matters</h3>
      <p>
        Record framework signals out of the box, add monitored tags, tune sampling, and filter or
        redact entries before they reach storage.
      </p>
      <div class="topic-links">
        <a href={route("/guides/watchers")}>Watchers</a>
        <a href={route("/reference/configuration")}>Configuration</a>
      </div>
    </article>

    <article>
      <h3>Operate without guesswork</h3>
      <p>
        Diagnose installation wiring, pause noisy environments, prune old data, and move a recorded
        batch between machines for focused debugging.
      </p>
      <div class="topic-links">
        <a href={route("/reference/commands")}>Ace commands</a>
        <a href={route("/guides/operations")}>Operations</a>
        <a href={route("/reference/batch-export")}>Batch exports</a>
      </div>
    </article>

    <article>
      <h3>Test and extend on public seams</h3>
      <p>
        Assert recorded behavior in Japa, consume the dashboard API, or add queue, scheduler,
        notification, socket, watcher, storage, and fanout adapters.
      </p>
      <div class="topic-links">
        <a href={route("/guides/testing")}>Testing helpers</a>
        <a href={route("/reference/http-api")}>HTTP API</a>
        <a href={route("/reference/adapters")}>Adapter authoring</a>
      </div>
    </article>
  </div>
</section>

<aside class="local-posture" aria-labelledby="posture-heading">
  <div>
    <p class="section-label">A deliberate local-first posture</p>
    <h2 id="posture-heading">Your diagnostics stay in your application.</h2>
  </div>
  <div class="posture-copy">
    <p>
      Periscope ships without an outbound telemetry path. It is designed for development and
      staging, remains disabled in production by default, and runs redaction before entries are
      buffered.
    </p>
    <div class="posture-links">
      <a href={route("/guides/dashboard")}>Secure the dashboard <span aria-hidden="true">→</span></a>
      <a href={route("/guides/operations")}>Plan retention and sampling <span aria-hidden="true">→</span></a>
    </div>
  </div>
</aside>

<section class="next-step" aria-labelledby="next-heading">
  <div>
    <h2 id="next-heading">Inspect your first request.</h2>
    <p>Install the provider, open <code>/periscope</code>, and generate application traffic.</p>
  </div>
  <a class="primary-action" href={route("/get-started")}>Follow the two-minute quickstart</a>
</section>

<style>
  main {
    overflow: hidden;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(24rem, 0.92fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    width: min(78rem, calc(100% - 3rem));
    min-height: min(48rem, calc(100vh - 3.5rem));
    margin: 0 auto;
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .hero-copy {
    max-width: 44rem;
  }

  .product-context {
    width: fit-content;
    margin: 0 0 1.5rem;
    border: 1px solid var(--nb-border);
    border-radius: 999px;
    background: var(--nb-accent);
    padding: 0.35rem 0.75rem;
    color: var(--nb-accent-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--nb-foreground);
    font-size: clamp(2.8rem, 6.3vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero-summary {
    max-width: 62ch;
    margin: 1.75rem 0 0;
    color: var(--nb-muted-foreground);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding-inline: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .hero-actions a:hover {
    transform: translateY(-1px);
  }

  .primary-action {
    border: 1px solid var(--nb-primary);
    background: var(--nb-primary);
    color: var(--nb-primary-foreground);
  }

  .primary-action:hover {
    border-color: var(--nb-primary-hover);
    background: var(--nb-primary-hover);
  }

  .secondary-action {
    border: 1px solid var(--nb-border-strong);
    color: var(--nb-foreground);
  }

  .secondary-action:hover {
    border-color: var(--nb-primary);
    color: var(--nb-primary);
  }

  .install-command {
    display: flex;
    width: fit-content;
    max-width: 100%;
    gap: 0.75rem;
    margin-top: 2rem;
    border-top: 1px solid var(--nb-border);
    padding-top: 1.25rem;
    color: var(--nb-muted-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.8125rem;
  }

  .install-command code {
    overflow-wrap: anywhere;
    color: var(--nb-foreground);
  }

  .signal-map {
    position: relative;
    min-height: 30rem;
    margin: 0;
    border: 1px solid var(--nb-border);
    border-radius: 1rem;
    background: var(--nb-card);
    box-shadow: var(--nb-shadow-lg);
    isolation: isolate;
    overflow: hidden;
  }

  .signal-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--nb-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--nb-border) 1px, transparent 1px);
    background-size: 2rem 2rem;
    mask-image: radial-gradient(circle at center, black, transparent 78%);
    opacity: 0.55;
  }

  .signal-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: var(--nb-border-strong);
  }

  .signal-lines path {
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
  }

  .lens {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 8.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--nb-border-strong);
    border-radius: 50%;
    background: var(--nb-background);
    color: var(--nb-foreground);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 1rem color-mix(in oklch, var(--nb-primary) 6%, transparent);
  }

  .lens svg {
    width: 3.5rem;
  }

  .lens span {
    position: absolute;
    top: calc(50% + 2.4rem);
    color: var(--nb-muted-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.6875rem;
  }

  .signal-label {
    position: absolute;
    border: 1px solid var(--nb-border);
    border-radius: 0.4rem;
    background: var(--nb-background);
    padding: 0.4rem 0.65rem;
    color: var(--nb-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    box-shadow: var(--nb-shadow-sm);
  }

  .signal-request {
    top: 15%;
    left: 7%;
  }

  .signal-query {
    top: 18%;
    right: 7%;
  }

  .signal-exception {
    bottom: 15%;
    left: 6%;
  }

  .signal-job {
    right: 8%;
    bottom: 18%;
  }

  .signal-map figcaption {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    left: 1.25rem;
    color: var(--nb-muted-foreground);
    font-size: 0.75rem;
    text-align: center;
  }

  .docs-directory {
    display: grid;
    grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    width: min(78rem, calc(100% - 3rem));
    margin: 0 auto;
    border-top: 1px solid var(--nb-border);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .directory-intro h2 {
    margin: 0;
    color: var(--nb-foreground);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .directory-intro p {
    margin: 1rem 0 0;
    color: var(--nb-muted-foreground);
    line-height: 1.65;
  }

  .directory-links {
    border-top: 1px solid var(--nb-border);
  }

  .directory-links a {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    align-items: baseline;
    border-bottom: 1px solid var(--nb-border);
    padding: 1.25rem 0;
    color: var(--nb-foreground);
    text-decoration: none;
    transition:
      color 160ms ease,
      padding-left 160ms ease;
  }

  .directory-links a:hover {
    padding-left: 0.35rem;
    color: var(--nb-primary);
  }

  .directory-links span {
    font-weight: 600;
  }

  .directory-links small {
    color: var(--nb-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .batch-story,
  .capability-index,
  .local-posture,
  .next-step {
    width: min(78rem, calc(100% - 3rem));
    margin: 0 auto;
    border-top: 1px solid var(--nb-border);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .batch-story {
    display: grid;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .section-label {
    margin: 0 0 1rem;
    color: var(--nb-primary);
    font-family: var(--nb-font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .batch-copy h2,
  .capability-heading h2,
  .local-posture h2,
  .next-step h2 {
    margin: 0;
    color: var(--nb-foreground);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .batch-copy > p:not(.section-label),
  .capability-heading > p,
  .posture-copy > p,
  .next-step p {
    max-width: 64ch;
    margin: 1.5rem 0 0;
    color: var(--nb-muted-foreground);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .text-link,
  .posture-links a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--nb-foreground);
    font-weight: 600;
    text-decoration-color: var(--nb-border-strong);
    text-underline-offset: 0.25rem;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .text-link {
    margin-top: 1.75rem;
  }

  .text-link:hover,
  .posture-links a:hover {
    color: var(--nb-primary);
    text-decoration-color: var(--nb-primary);
  }

  .batch-timeline {
    margin: 0;
    border: 1px solid var(--nb-border);
    border-radius: 1rem;
    background: var(--nb-card);
    box-shadow: var(--nb-shadow-lg);
    overflow: hidden;
  }

  .batch-timeline figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--nb-border);
    padding: 1rem 1.25rem;
    color: var(--nb-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.8125rem;
  }

  .batch-timeline figcaption small {
    color: var(--nb-muted-foreground);
    font: inherit;
  }

  .batch-timeline ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .batch-timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 4.25rem 4.75rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    margin-left: 1.35rem;
    border-bottom: 1px solid var(--nb-border);
    padding: 1.05rem 1.25rem 1.05rem 1.5rem;
    font-size: 0.8125rem;
  }

  .batch-timeline li::before {
    position: absolute;
    top: 50%;
    left: -0.25rem;
    width: 0.5rem;
    aspect-ratio: 1;
    border: 2px solid var(--nb-card);
    border-radius: 50%;
    background: var(--nb-primary);
    box-shadow: 0 0 0 1px var(--nb-primary);
    content: "";
    transform: translateY(-50%);
  }

  .batch-timeline li::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.03rem;
    z-index: -1;
    width: 1px;
    background: var(--nb-border-strong);
    content: "";
  }

  .batch-timeline li:last-child {
    border-bottom: 0;
  }

  .batch-timeline time,
  .batch-timeline .entry-type,
  .batch-timeline li small {
    color: var(--nb-muted-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
  }

  .batch-timeline .entry-type {
    color: var(--nb-primary);
  }

  .batch-timeline strong {
    overflow: hidden;
    color: var(--nb-foreground);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .capability-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.78fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .capability-heading > p {
    margin-top: 0;
  }

  .capability-rows {
    border-top: 1px solid var(--nb-border);
  }

  .capability-rows article {
    display: grid;
    grid-template-columns: minmax(13rem, 0.65fr) minmax(18rem, 1.15fr) minmax(12rem, 0.7fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    border-bottom: 1px solid var(--nb-border);
    padding-block: 2rem;
  }

  .capability-rows h3 {
    margin: 0;
    color: var(--nb-foreground);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .capability-rows article > p {
    margin: 0;
    color: var(--nb-muted-foreground);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .topic-links a {
    color: var(--nb-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration-color: var(--nb-border-strong);
    text-underline-offset: 0.25rem;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .topic-links a:hover {
    color: var(--nb-primary);
    text-decoration-color: var(--nb-primary);
  }

  .local-posture {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .posture-copy > p {
    margin-top: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .posture-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .next-step {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 5rem);
  }

  .next-step h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
  }

  .next-step p {
    margin-top: 0.75rem;
  }

  .next-step code {
    color: var(--nb-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.9em;
  }

  .next-step .primary-action {
    display: inline-flex;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--nb-primary);
    border-radius: 0.5rem;
    background: var(--nb-primary);
    padding-inline: 1rem;
    color: var(--nb-primary-foreground);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .next-step .primary-action:hover {
    border-color: var(--nb-primary-hover);
    background: var(--nb-primary-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .hero-shell {
      grid-template-columns: 1fr;
    }

    .signal-map {
      min-height: 25rem;
    }

    .batch-story,
    .capability-heading,
    .local-posture {
      grid-template-columns: 1fr;
    }

    .batch-story,
    .local-posture {
      gap: 3rem;
    }

    .capability-heading {
      gap: 1.5rem;
    }

    .capability-rows article {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    }

    .topic-links {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .hero-shell,
    .docs-directory,
    .batch-story,
    .capability-index,
    .local-posture,
    .next-step {
      width: min(100% - 2rem, 78rem);
    }

    .hero-shell {
      padding-block: 3.5rem;
    }

