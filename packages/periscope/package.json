{
  "name": "adonisjs-periscope",
  "version": "0.1.0",
  "description": "A Laravel-Telescope-style debug assistant for AdonisJS v7",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./build/src/index.js",
    "./package.json": "./package.json",
    "./provider": "./build/providers/periscope_provider.js",
    "./services/recorder": "./build/src/recorder/service.js",
    "./middleware/request_watcher": "./build/src/watchers/request/middleware.js",
    "./exception_reporter": "./build/src/watchers/exception/mixin.js",
    "./log_stream": "./build/src/watchers/log/stream.js",
    "./dump": "./build/src/dump.js",
    "./hooks": "./build/src/hooks/doctor.js",
    "./commands": "./build/commands/main.js",
    "./types": "./build/src/types.js",
    "./periscope_config": "./build/src/define_config.js",
    "./storage_schema": "./build/src/storage/database_schema.js",
    "./watchers/bull_queue": "./build/src/watchers/job_schedule/bull_queue_adapter.js"
  },
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "!build/tests_helpers"
  ],
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('build', { recursive: true, force: true })\"",
    "compile": "tsc",
    "postcompile": "npm run copy:templates && npm run index:commands",
    "copy:templates": "node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('stubs', 'build/stubs', { recursive: true })\"",
    "index:commands": "adonis-kit index build/commands",
    "prepack": "node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('../../README.md', 'README.md')\"",
    "build": "npm run clean && npm run compile",
    "test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "bench:overhead": "node --import=@poppinss/ts-exec --enable-source-maps tests/bench/overhead.bench.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "peerDependencies": {
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/cache": "^2.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": ">=22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.0.0",
    "@opentelemetry/api": ">=1.9.0",
    "bullmq": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/bouncer": {
      "optional": true
    },
    "@adonisjs/cache": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/redis": {
      "optional": true
    },
    "@adonisjs/session": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/core": "^7.3.5",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.9.1",
    "@types/pg": "^8.20.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.4.0",
    "fast-check": "^4.9.0",
    "luxon": "^3.7.2",
    "mitata": "^1.0.34",
    "bullmq": "^5.81.2",
    "pg": "^8.22.0",
    "typescript": "~6.0.3"
  },
  "prettier": "@adonisjs/prettier-config"
}
