# Committed on purpose: the playground is a throwaway fixture app used by the
# Periscope test-suite and manual QA. Committing it means `npm -w playground run dev`
# boots with zero setup. The APP_KEY below is a well-known development key and must
# never be reused by a real application.
#
# `playground/.gitignore` negates the repo-root `.env` ignore rule for this file only.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
